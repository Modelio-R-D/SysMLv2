from collections import deque

def find_child(el, name):
    for c in el.getCompositionChildren():
        if c.getName() == name:
            return c
    return None

sysml2Root = None
for root in modelingSession.getModel().getModelRoots():
    if root.getName() == "sysml2":
        sysml2Root = root
        break
pkgRoot = find_child(sysml2Root, "modelio.sysml2")
refPkg = find_child(pkgRoot, "reference")
specPkg = find_child(refPkg, "spec")
designPkg = find_child(refPkg, "design")

sysmlSpecComp = find_child(specPkg, "SysML")
moduleName = sysmlSpecComp.getExtension()[0].getModule().getName()
mmExt = modelingSession.getMetamodelExtensions()

def bfs_find_first_named(root, name, mclass, max_nodes=20000):
    q = deque([root])
    seen = set()
    while q:
        el = q.popleft()
        eid = el.getUuid()
        if eid in seen:
            continue
        seen.add(eid)
        try:
            if not el.isDeleted() and el.getName() == name and el.getMClass().getName() == mclass:
                return el
        except:
            pass
        try:
            for c in el.getCompositionChildren():
                q.append(c)
        except:
            pass
    return None

designClassifier = bfs_find_first_named(designPkg, "Classifier", "Class")
print "design Classifier isStereotyped Semantic:", designClassifier.isStereotyped(moduleName, "Semantic")
print "design Classifier isStereotyped JavaClass:", designClassifier.isStereotyped(moduleName, "JavaClass")

print ""
print "findStereotypes('.*JavaClass.*', Classifier's MClass):"
try:
    stereos = mmExt.findStereotypes(".*JavaClass.*", designClassifier.getMClass())
    for s in stereos:
        print "  ", s.getName()
except Exception, e:
    print "  FAILED:", e

# Check: does a REAL, already-working metamodel (analyst) have any class stereotyped JavaClass?
analystRoot = None
for root in modelingSession.getModel().getModelRoots():
    if root.getName() == "analyst":
        analystRoot = root
        break

def bfs_find_stereotyped(root, moduleName, stereoName, max_nodes=2000):
    q = deque([root])
    seen = set()
    hits = []
    visited = 0
    while q:
        el = q.popleft()
        eid = el.getUuid()
        if eid in seen:
            continue
        seen.add(eid)
        visited += 1
        if visited > max_nodes:
            break
        try:
            if el.isStereotyped(moduleName, stereoName):
                hits.append(el)
        except:
            pass
        try:
            for c in el.getCompositionChildren():
                q.append(c)
        except:
            pass
    return hits, visited

hits, visited = bfs_find_stereotyped(analystRoot, moduleName, "JavaClass", max_nodes=2000)
print ""
print "analyst: visited=%d JavaClass-stereotyped hits=%d" % (visited, len(hits))
for h in hits[:10]:
    try:
        print "  ", h.getName(), "(", h.getMClass().getName(), ")"
    except:
        pass
