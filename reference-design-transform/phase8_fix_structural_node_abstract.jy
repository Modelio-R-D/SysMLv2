from org.eclipse.core.runtime import NullProgressMonitor
from collections import deque

factory = modelingSession.getModel()

def find_child(el, name):
    for c in el.getCompositionChildren():
        if c.getName() == name:
            return c
    return None

sysml2Root = None
for root in modelingSession.getModel().getModelRoots():
    if root.getName() == "sysml2":
        sysml2Root = root
        break
pkgRoot = find_child(sysml2Root, "modelio.sysml")
refPkg = find_child(pkgRoot, "reference")
designPkg = find_child(refPkg, "design")

def bfs_collect_list(root, mclasses, max_nodes=20000):
    q = deque([root])
    seen = set()
    out = []
    visited = 0
    while q:
        el = q.popleft()
        eid = el.getUuid()
        if eid in seen:
            continue
        seen.add(eid)
        visited += 1
        if visited > max_nodes:
            break
        try:
            if el.isDeleted():
                continue
            mcls = el.getMClass().getName()
            if mcls in mclasses:
                out.append(el)
        except:
            pass
        try:
            for c in el.getCompositionChildren():
                q.append(c)
        except:
            pass
    return out, visited

designClasses, dv = bfs_collect_list(designPkg, set(["Class"]))

# Exact target set: the 8 abstract classes confirmed flagged with Semantic.structural.node.
TARGET_NAMES = set([
    "ConnectorAsUsage", "ControlNode", "LoopActionUsage", "Expose",
    "KerMLModelElement", "Relationship", "Import", "InstantiationExpression",
])

targets = [c for c in designClasses if c.getName() in TARGET_NAMES]
print "targets found:", [t.getName() for t in targets]
if len(targets) != len(TARGET_NAMES):
    print "FAIL CLOSED: expected", len(TARGET_NAMES), "found", len(targets)
else:
    tr = modelingSession.createTransaction("Fix: unset Semantic.structural.node on abstract design classes")
    try:
        removed = 0
        for cls in targets:
            if not cls.isIsAbstract():
                raise Exception("safety check failed: " + cls.getName() + " is not abstract")
            for t in list(cls.getTag()):
                defn = t.getDefinition()
                if defn and defn.getName() == "Semantic.structural.node":
                    for p in list(t.getActual()):
                        p.delete()
                    t.delete()
                    removed += 1
        tr.commit()
        print "COMMITTED OK, tags removed:", removed
    except Exception, e:
        tr.rollback()
        print "ROLLED BACK:", e
        raise

    projectService.saveProject(NullProgressMonitor())
    print "isDirty after save:", projectService.isDirty()
