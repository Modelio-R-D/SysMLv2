from org.eclipse.core.runtime import NullProgressMonitor
import json

# Completes phase20 for the 47 properties it deliberately left alone: their reference/design
# "description" note already held a machine-readable "Redefines (per normative XMI): ..." (or
# "Subsets (per normative XMI): ...") directive, added by an earlier phase, with no human
# prose alongside it -- because both purposes share the exact same note field, and phase20's
# safety rule ("never overwrite existing content") correctly refused to clobber the directive
# with prose. That refusal was right, but it left these 47 without documentation. This script
# adds the prose ABOVE the existing directive line(s), never replacing them -- the same
# multi-line-directives-coexist-in-one-note shape already used elsewhere in this model (e.g. a
# property carrying both a "Subsets" and a "Redefines" line together).
#
# Idempotent: if the target's content already contains this exact comment text verbatim
# (a prior run already appended it), it is skipped rather than duplicated.

FIXES_PATH = r"C:\Users\jcadavid\AppData\Local\Temp\claude\c--Users-jcadavid-OneDrive---LA-POSTE-GROUPE-SysMLv2\5277a14e-87b7-447d-bb53-a5a92a3c9bb4\scratchpad\final_ownedend_fixes.json"

with open(FIXES_PATH, "r") as f:
    fixes = json.load(f)

mmExt = modelingSession.getMetamodelExtensions()

def find_child(el, name):
    for c in el.getCompositionChildren():
        if c.getName() == name:
            return c
    return None

sysml2Root = None
for root in modelingSession.getModel().getModelRoots():
    if root.getName() == "sysml2":
        sysml2Root = root
        break
if sysml2Root is None:
    raise Exception("sysml2 root not found")

pkgRoot = find_child(sysml2Root, "modelio.sysml")
refPkg = find_child(pkgRoot, "reference")
designPkg = find_child(refPkg, "design")
if designPkg is None:
    raise Exception("reference/design not found")

def find_class(pkg, name, depth=0):
    if depth > 60:
        return None
    for c in pkg.getCompositionChildren():
        try:
            if c.getMClass().getName() == "Class" and c.getName() == name:
                return c
        except:
            pass
        found = find_class(c, name, depth + 1)
        if found:
            return found
    return None

def description_note_type(element):
    for noteType in mmExt.findNoteTypes("", element.getMClass()):
        if noteType.getName().lower() == "description":
            return noteType
    return None

def description_content(element):
    nt = description_note_type(element)
    if nt is None:
        return None
    note = element.getNote(nt)
    return note.getContent() if note else None

def set_description(element, content):
    nt = description_note_type(element)
    if nt is None:
        raise Exception("No description NoteType for " + element.getMClass().getName())
    element.putNoteContent(nt, content)

def design_owner_name(spec_owner_name):
    return "KerMLModelElement" if spec_owner_name == "Element" else spec_owner_name

class_cache = {}

def get_class(name):
    if name not in class_cache:
        class_cache[name] = find_class(designPkg, name)
    return class_cache[name]

to_apply = []
already_has_prose = []
not_a_pure_directive = []

for fix in fixes:
    owner_name = design_owner_name(fix["owner"])
    end_name = fix["end"]
    comment = fix["comment"]
    owner_class = get_class(owner_name)
    if owner_class is None:
        continue
    end = None
    for e in owner_class.getOwnedEnd():
        if e.getName() == end_name:
            end = e
            break
    if end is None:
        continue
    existing = description_content(end)
    if not existing or not existing.strip():
        continue  # phase20 already handled the empty case
    if comment in existing:
        already_has_prose.append((owner_name, end_name))
        continue
    if "per normative XMI" not in existing:
        # Something else entirely occupies this note -- don't guess, leave for manual review.
        not_a_pure_directive.append((owner_name, end_name, existing))
        continue
    to_apply.append((end, owner_name, end_name, comment + "\n" + existing))

print "already has this exact prose (skipped, idempotent):", len(already_has_prose)
print "existing content isn't a bare directive (skipped, needs manual look):", len(not_a_pure_directive)
for o, e, c in not_a_pure_directive:
    print "  ", o + "." + e, ":", repr(c[:80])
print "ready to prepend prose onto:", len(to_apply)
for end, o, e, new_content in to_apply:
    print "  ", o + "." + e

changed = 0
tr = modelingSession.createTransaction("Phase 21: prepend prose alongside existing Redefines/Subsets directives")
try:
    for end, owner_name, end_name, new_content in to_apply:
        set_description(end, new_content)
        changed += 1
    tr.commit()
    print "COMMITTED OK, notes updated:", changed
except Exception, e:
    tr.rollback()
    print "ROLLED BACK:", e
    raise

if changed > 0:
    projectService.saveProject(NullProgressMonitor())
    print "isDirty after save:", projectService.isDirty()
else:
    print "NO-OP: project save skipped"
