from collections import deque

factory = modelingSession.getModel()

def find_child(el, name):
    for c in el.getCompositionChildren():
        if c.getName() == name:
            return c
    return None

sysml2Root = None
for root in modelingSession.getModel().getModelRoots():
    if root.getName() == "sysml2":
        sysml2Root = root
        break
pkgRoot = find_child(sysml2Root, "modelio.sysml")
refPkg = find_child(pkgRoot, "reference")
designPkg = find_child(refPkg, "design")

sysmlSpecComp = find_child(find_child(refPkg, "spec"), "SysML")
moduleName = sysmlSpecComp.getExtension()[0].getModule().getName()

def bfs_collect_list(root, mclasses, max_nodes=20000):
    q = deque([root])
    seen = set()
    out = []
    visited = 0
    while q:
        el = q.popleft()
        eid = el.getUuid()
        if eid in seen:
            continue
        seen.add(eid)
        visited += 1
        if visited > max_nodes:
            break
        try:
            if el.isDeleted():
                continue
            mcls = el.getMClass().getName()
            if mcls in mclasses:
                out.append(el)
        except:
            pass
        try:
            for c in el.getCompositionChildren():
                q.append(c)
        except:
            pass
    return out, visited

designClasses, dv = bfs_collect_list(designPkg, set(["Class"]))
print "design classes visited/found:", dv, len(designClasses)

abstract_flagged = 0
abstract_total = 0
concrete_flagged = 0
concrete_total = 0
unflagged_names = []
abstract_flagged_names = []

for cls in designClasses:
    isAbs = cls.isIsAbstract()
    hasNodeTag = False
    for t in cls.getTag():
        defn = t.getDefinition()
        if defn and defn.getName() == "Semantic.structural.node":
            hasNodeTag = True
            break
    if isAbs:
        abstract_total += 1
        if hasNodeTag:
            abstract_flagged += 1
            abstract_flagged_names.append(cls.getName())
    else:
        concrete_total += 1
        if hasNodeTag:
            concrete_flagged += 1
        else:
            unflagged_names.append(cls.getName())

print "abstract classes:", abstract_total, "flagged structural.node:", abstract_flagged
print "concrete classes:", concrete_total, "flagged structural.node:", concrete_flagged
print "abstract+flagged sample:", abstract_flagged_names[:15]
print "unflagged concrete sample:", unflagged_names[:15]
