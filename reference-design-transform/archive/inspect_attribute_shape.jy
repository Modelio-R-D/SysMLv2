from collections import deque

def find_child(el, name):
    for c in el.getCompositionChildren():
        if c.getName() == name:
            return c
    return None

sysml2Root = None
for root in modelingSession.getModel().getModelRoots():
    if root.getName() == "sysml2":
        sysml2Root = root
        break
pkgRoot = find_child(sysml2Root, "modelio.sysml2")
refPkg = find_child(pkgRoot, "reference")
specPkg = find_child(refPkg, "spec")

def bfs_find_first_of_type(root, typeName, max_nodes=6000):
    q = deque([root])
    seen = set()
    visited = 0
    while q:
        el = q.popleft()
        eid = el.getUuid()
        if eid in seen:
            continue
        seen.add(eid)
        visited += 1
        if visited > max_nodes:
            break
        try:
            if el.getMClass().getName() == typeName:
                return el, visited
        except:
            pass
        try:
            for c in el.getCompositionChildren():
                q.append(c)
        except:
            pass
    return None, visited

attr, visited = bfs_find_first_of_type(specPkg, "Attribute", max_nodes=6000)
print "visited:", visited
print "attr:", attr
print "owner:", attr.getCompositionOwner().getName()
print ""
print "relevant dir():"
for m in dir(attr):
    if not m.startswith("_") and ('ult' in m.lower() or 'ype' in m.lower() or 'ulti' in m.lower() or 'visib' in m.lower()):
        print "  ", m

print ""
print "current values:"
print "  getName():", attr.getName()
try:
    print "  getType():", attr.getType()
except Exception, e:
    print "  getType() failed:", e
try:
    print "  getMultiplicityMin():", attr.getMultiplicityMin()
    print "  getMultiplicityMax():", attr.getMultiplicityMax()
except Exception, e:
    print "  multiplicity failed:", e
try:
    print "  getDefaultValue():", attr.getDefaultValue()
except Exception, e:
    print "  getDefaultValue() failed:", e
