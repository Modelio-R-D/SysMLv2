from collections import deque

def find_child(el, name):
    for c in el.getCompositionChildren():
        if c.getName() == name:
            return c
    return None

sysml2Root = None
for root in modelingSession.getModel().getModelRoots():
    if root.getName() == "sysml2":
        sysml2Root = root
        break
pkgRoot = find_child(sysml2Root, "modelio.sysml2")
refPkg = find_child(pkgRoot, "reference")
designPkg = find_child(refPkg, "design")

def bfs_find_first_named(root, name, mclass, max_nodes=20000):
    q = deque([root])
    seen = set()
    while q:
        el = q.popleft()
        eid = el.getUuid()
        if eid in seen:
            continue
        seen.add(eid)
        try:
            if not el.isDeleted() and el.getName() == name and el.getMClass().getName() == mclass:
                return el
        except:
            pass
        try:
            for c in el.getCompositionChildren():
                q.append(c)
        except:
            pass
    return None

def bfs_collect_list(root, mclasses, max_nodes=20000):
    q = deque([root])
    seen = set()
    out = []
    visited = 0
    while q:
        el = q.popleft()
        eid = el.getUuid()
        if eid in seen:
            continue
        seen.add(eid)
        visited += 1
        if visited > max_nodes:
            break
        try:
            if el.isDeleted():
                continue
            mcls = el.getMClass().getName()
            if mcls in mclasses:
                out.append(el)
        except:
            pass
        try:
            for c in el.getCompositionChildren():
                q.append(c)
        except:
            pass
    return out, visited

kerMLModelElement = bfs_find_first_named(designPkg, "KerMLModelElement", "Class")
sysmlProject = bfs_find_first_named(designPkg, "SysMLProject", "Class")

gens, _ = bfs_collect_list(designPkg, set(["Generalization"]))
for g in gens:
    sub = g.getSubType()
    if sub and sub.getUuid() in (kerMLModelElement.getUuid(), sysmlProject.getUuid()):
        sup = g.getSuperType()
        print sub.getName(), "extends", sup.getName() if sup else None, "(", (sup.getMClass().getName() if sup else None), ")"

print ""
print "SysMLProject tags:"
for t in sysmlProject.getTag():
    defn = t.getDefinition()
    print "  ", defn.getName() if defn else None, "-> actual count:", len(t.getActual())

print ""
print "any class still named plain 'Element':", bfs_find_first_named(designPkg, "Element", "Class")
