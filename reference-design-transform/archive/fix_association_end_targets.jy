from org.eclipse.core.runtime import NullProgressMonitor
from collections import deque

def find_child(el, name):
    for c in el.getCompositionChildren():
        if c.getName() == name:
            return c
    return None

sysml2Root = None
for root in modelingSession.getModel().getModelRoots():
    if root.getName() == "sysml2":
        sysml2Root = root
        break
pkgRoot = find_child(sysml2Root, "modelio.sysml2")
refPkg = find_child(pkgRoot, "reference")
designPkg = find_child(refPkg, "design")

def bfs_collect_list(root, mclasses, max_nodes=20000):
    q = deque([root])
    seen = set()
    out = []
    visited = 0
    while q:
        el = q.popleft()
        eid = el.getUuid()
        if eid in seen:
            continue
        seen.add(eid)
        visited += 1
        if visited > max_nodes:
            break
        try:
            if el.isDeleted():
                continue
            mcls = el.getMClass().getName()
            if mcls in mclasses:
                out.append(el)
        except:
            pass
        try:
            for c in el.getCompositionChildren():
                q.append(c)
        except:
            pass
    return out, visited

ends, ev = bfs_collect_list(designPkg, set(["AssociationEnd"]))
print "total design AssociationEnd:", len(ends)

stats = {"fixed": 0, "already_ok": 0, "no_opposite": 0}

tr = modelingSession.createTransaction("Fix: set Target on all design AssociationEnds")
try:
    for e in ends:
        if e.getTarget() is not None:
            stats["already_ok"] += 1
            continue
        opp = e.getOpposite()
        if opp is None:
            stats["no_opposite"] += 1
            continue
        oppOwner = opp.getCompositionOwner()
        if oppOwner is None:
            stats["no_opposite"] += 1
            continue
        e.setTarget(oppOwner)
        stats["fixed"] += 1
    tr.commit()
    print "COMMITTED OK"
except Exception, e:
    tr.rollback()
    print "ROLLED BACK:", e
    raise

print "stats:", stats

projectService.saveProject(NullProgressMonitor())
print "isDirty after save:", projectService.isDirty()
