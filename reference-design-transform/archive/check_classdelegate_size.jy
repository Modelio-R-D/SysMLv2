from collections import deque

def find_child(el, name):
    for c in el.getCompositionChildren():
        if c.getName() == name:
            return c
    return None

sysml2Root = None
for root in modelingSession.getModel().getModelRoots():
    if root.getName() == "sysml2":
        sysml2Root = root
        break
pkgRoot = find_child(sysml2Root, "modelio.sysml2")
refPkg = find_child(pkgRoot, "reference")
designPkg = find_child(refPkg, "design")

def bfs_find_first_named(root, name, mclass, max_nodes=20000):
    q = deque([root])
    seen = set()
    while q:
        el = q.popleft()
        eid = el.getUuid()
        if eid in seen:
            continue
        seen.add(eid)
        try:
            if not el.isDeleted() and el.getName() == name and el.getMClass().getName() == mclass:
                return el
        except:
            pass
        try:
            for c in el.getCompositionChildren():
                q.append(c)
        except:
            pass
    return None

occDef = bfs_find_first_named(designPkg, "OccurrenceDefinition", "Class")
classDeleg = bfs_find_first_named(occDef, "ClassDelegate", "Class")
print "ClassDelegate:", classDeleg
attrs = [a for a in classDeleg.getOwnedAttribute() if not a.isDeleted()]
ops = [o for o in classDeleg.getOwnedOperation() if not o.isDeleted()]
print "attribute count:", len(attrs)
print "operation count:", len(ops)
print ""
print "attribute names:", [a.getName() for a in attrs]
print ""
print "operation names:", [o.getName() for o in ops]
