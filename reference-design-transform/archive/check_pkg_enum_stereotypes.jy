from collections import deque

def find_child(el, name):
    for c in el.getCompositionChildren():
        if c.getName() == name:
            return c
    return None

sysml2Root = None
for root in modelingSession.getModel().getModelRoots():
    if root.getName() == "sysml2":
        sysml2Root = root
        break
pkgRoot = find_child(sysml2Root, "modelio.sysml2")
refPkg = find_child(pkgRoot, "reference")
specPkg = find_child(refPkg, "spec")

sysmlSpecComp = find_child(specPkg, "SysML")
moduleName = sysmlSpecComp.getExtension()[0].getModule().getName()

def bfs_collect_list(root, mclasses, max_nodes=6000):
    q = deque([root])
    seen = set()
    out = []
    visited = 0
    while q:
        el = q.popleft()
        eid = el.getUuid()
        if eid in seen:
            continue
        seen.add(eid)
        visited += 1
        if visited > max_nodes:
            break
        try:
            if el.isDeleted():
                continue
            mcls = el.getMClass().getName()
            if mcls in mclasses:
                out.append(el)
        except:
            pass
        try:
            for c in el.getCompositionChildren():
                q.append(c)
        except:
            pass
    return out, visited

pkgs, pv = bfs_collect_list(specPkg, set(["Package"]))
enums, ev = bfs_collect_list(specPkg, set(["Enumeration"]))

stereotyped_pkgs = [p for p in pkgs if p.isStereotyped(moduleName, "Semantic")]
unstereotyped_pkgs = [p for p in pkgs if not p.isStereotyped(moduleName, "Semantic")]
print "total packages:", len(pkgs)
print "stereotyped Semantic:", len(stereotyped_pkgs)
print "NOT stereotyped:", len(unstereotyped_pkgs)
for p in unstereotyped_pkgs:
    print "  unstereotyped:", p.getName(), "owner:", p.getCompositionOwner().getName() if p.getCompositionOwner() else None

print ""
print "total enumerations:", len(enums)
for e in enums:
    print "  ", e.getName(), "isStereotyped Semantic:", e.isStereotyped(moduleName, "Semantic")
