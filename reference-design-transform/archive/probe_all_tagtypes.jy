from collections import deque

def find_child(el, name):
    for c in el.getCompositionChildren():
        if c.getName() == name:
            return c
    return None

sysml2Root = None
for root in modelingSession.getModel().getModelRoots():
    if root.getName() == "sysml2":
        sysml2Root = root
        break
pkgRoot = find_child(sysml2Root, "modelio.sysml2")
refPkg = find_child(pkgRoot, "reference")
specPkg = find_child(refPkg, "spec")
sysmlSpecComp = find_child(specPkg, "SysML")
moduleName = sysmlSpecComp.getExtension()[0].getModule().getName()

mmExt = modelingSession.getMetamodelExtensions()

def bfs_find_first_of_type(root, typeName, max_nodes=6000):
    q = deque([root])
    seen = set()
    while q:
        el = q.popleft()
        eid = el.getUuid()
        if eid in seen:
            continue
        seen.add(eid)
        try:
            if not el.isDeleted() and el.getMClass().getName() == typeName:
                return el
        except:
            pass
        try:
            for c in el.getCompositionChildren():
                q.append(c)
        except:
            pass
    return None

sampleClass = bfs_find_first_of_type(specPkg, "Class")
sampleAttr = bfs_find_first_of_type(specPkg, "Attribute")
sampleEnd = bfs_find_first_of_type(specPkg, "AssociationEnd")

for label, sample in [("Class", sampleClass), ("Attribute", sampleAttr), ("AssociationEnd", sampleEnd)]:
    mcls = sample.getMClass()
    print ""
    print "=== %s (%s) tag types ===" % (label, mcls.getName())
    try:
        tagTypes = mmExt.findTagTypes(".*", mcls)
        names = sorted(set([t.getName() for t in tagTypes]))
        for n in names:
            if not any(k in n for k in ["Java", "Template", "Pattern", "i18n", "modifyModel", "parameters", "generic", "nativeUid", "uid", "hidden", "icon", "image", "multiple", "editable", "Requires", "Exports", "Opens", "Uses", "Provides", "Open", "typeRef", "metaclass"]):
                print "  ", n
    except Exception, e:
        print "  FAILED:", e
