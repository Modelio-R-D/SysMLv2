from collections import deque

factory = modelingSession.getModel()

def find_child(el, name):
    for c in el.getCompositionChildren():
        if c.getName() == name:
            return c
    return None

sysml2Root = None
for root in modelingSession.getModel().getModelRoots():
    if root.getName() == "sysml2":
        sysml2Root = root
        break
pkgRoot = find_child(sysml2Root, "modelio.sysml2")
refPkg = find_child(pkgRoot, "reference")
designPkg = find_child(refPkg, "design")

def bfs_find_first_named(root, name, mclass, max_nodes=1000):
    q = deque([root])
    seen = set()
    while q:
        el = q.popleft()
        eid = el.getUuid()
        if eid in seen:
            continue
        seen.add(eid)
        try:
            if not el.isDeleted() and el.getName() == name and el.getMClass().getName() == mclass:
                return el
        except:
            pass
        try:
            for c in el.getCompositionChildren():
                q.append(c)
        except:
            pass
    return None

classA = bfs_find_first_named(designPkg, "AttributeDefinition", "Class")
classB = bfs_find_first_named(designPkg, "Class", "Class")
print "classA:", classA
print "classB:", classB

tr = modelingSession.createTransaction("probe manual association creation - will rollback")
try:
    endOnA = factory.createAssociationEnd()
    endOnA.setName("probeRoleOnA")
    classA.getOwnedEnd().add(endOnA)

    endOnB = factory.createAssociationEnd()
    endOnB.setName("")
    classB.getOwnedEnd().add(endOnB)

    endOnA.setOpposite(endOnB)
    endOnB.setOpposite(endOnA)

    assoc = factory.createAssociation()
    endOnA.setAssociation(assoc)
    endOnB.setAssociation(assoc)

    print "assoc:", assoc
    print "assoc.getEnd() count:", len(assoc.getEnd())
    for e in assoc.getEnd():
        print "  end name:", repr(e.getName())
        print "    compositionOwner:", e.getCompositionOwner().getName()
        print "    oppositeOwner:", e.getOppositeOwner().getName() if e.getOppositeOwner() else None
except Exception, e:
    print "manual creation FAILED:", e
finally:
    tr.rollback()
    print "rolled back probe transaction"
