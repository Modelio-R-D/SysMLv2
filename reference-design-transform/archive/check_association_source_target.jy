from collections import deque

def find_child(el, name):
    for c in el.getCompositionChildren():
        if c.getName() == name:
            return c
    return None

sysml2Root = None
for root in modelingSession.getModel().getModelRoots():
    if root.getName() == "sysml2":
        sysml2Root = root
        break
pkgRoot = find_child(sysml2Root, "modelio.sysml2")
refPkg = find_child(pkgRoot, "reference")
specPkg = find_child(refPkg, "spec")
designPkg = find_child(refPkg, "design")

def bfs_find_first_named(root, name, mclass, max_nodes=20000):
    q = deque([root])
    seen = set()
    while q:
        el = q.popleft()
        eid = el.getUuid()
        if eid in seen:
            continue
        seen.add(eid)
        try:
            if not el.isDeleted() and el.getName() == name and el.getMClass().getName() == mclass:
                return el
        except:
            pass
        try:
            for c in el.getCompositionChildren():
                q.append(c)
        except:
            pass
    return None

specDef = bfs_find_first_named(specPkg, "Definition", "Class")
specEnd = None
for e in specDef.getOwnedEnd():
    if e.getName() == "ownedUsage":
        specEnd = e
        break
specAssoc = specEnd.getAssociation()

print "FULL dir() of a real spec Association:"
for m in dir(specAssoc):
    if not m.startswith("_"):
        print "  ", m

print ""
print "source/target-like accessors and their values on spec's ownedUsage association:"
for m in dir(specAssoc):
    if not m.startswith("_") and ("source" in m.lower() or "target" in m.lower()):
        try:
            val = getattr(specAssoc, m)()
            print "  ", m, "->", (val.getName() if hasattr(val, "getName") else val)
        except Exception, e:
            print "  ", m, "-> (not callable / error:", e, ")"
