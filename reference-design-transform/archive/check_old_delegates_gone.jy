from collections import deque

def find_child(el, name):
    for c in el.getCompositionChildren():
        if c.getName() == name:
            return c
    return None

sysml2Root = None
for root in modelingSession.getModel().getModelRoots():
    if root.getName() == "sysml2":
        sysml2Root = root
        break
pkgRoot = find_child(sysml2Root, "modelio.sysml2")
refPkg = find_child(pkgRoot, "reference")
designPkg = find_child(refPkg, "design")

def bfs_collect_list(root, mclasses, max_nodes=20000):
    q = deque([root])
    seen = set()
    out = []
    visited = 0
    while q:
        el = q.popleft()
        eid = el.getUuid()
        if eid in seen:
            continue
        seen.add(eid)
        visited += 1
        if visited > max_nodes:
            break
        try:
            if el.isDeleted():
                continue
            mcls = el.getMClass().getName()
            if mcls in mclasses:
                out.append(el)
        except:
            pass
        try:
            for c in el.getCompositionChildren():
                q.append(c)
        except:
            pass
    return out, visited

allClasses, cv = bfs_collect_list(designPkg, set(["Class"]))
delegates = [c for c in allClasses if c.getName().endswith("Delegate")]
print "visited:", cv, "remaining Delegate classes:", len(delegates)
for d in delegates[:5]:
    print "  ", d.getName()

allAttrs, av = bfs_collect_list(designPkg, set(["Attribute"]))
print "total attributes remaining:", len(allAttrs)
print "isDirty:", projectService.isDirty()
