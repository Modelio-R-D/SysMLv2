from org.eclipse.core.runtime import NullProgressMonitor
import json

# Propagates the 241 ownedEnd descriptions phase19 just fixed in reference/spec onto their
# reference/design counterparts. Element is the ONLY metaclass renamed between spec and
# design (-> KerMLModelElement) -- confirmed earlier by diffing all class names between the
# two trees (175 spec / 171 design, fully accounted for: 5 intentional infrastructure
# redirects + this 1 rename on the spec-only side; 1 rename target + 1 brand-new class
# (SysMLProject) on the design-only side). So every other owner name below maps identically
# between spec and design; only "Element" maps to "KerMLModelElement".
#
# Nothing is overwritten: each design target's current note is checked empty first, exactly
# like phase19 did on the spec side.

FIXES_PATH = r"C:\Users\jcadavid\AppData\Local\Temp\claude\c--Users-jcadavid-OneDrive---LA-POSTE-GROUPE-SysMLv2\5277a14e-87b7-447d-bb53-a5a92a3c9bb4\scratchpad\final_ownedend_fixes.json"

with open(FIXES_PATH, "r") as f:
    fixes = json.load(f)

print "fixes loaded:", len(fixes)

mmExt = modelingSession.getMetamodelExtensions()

def find_child(el, name):
    for c in el.getCompositionChildren():
        if c.getName() == name:
            return c
    return None

sysml2Root = None
for root in modelingSession.getModel().getModelRoots():
    if root.getName() == "sysml2":
        sysml2Root = root
        break
if sysml2Root is None:
    raise Exception("sysml2 root not found")

pkgRoot = find_child(sysml2Root, "modelio.sysml")
refPkg = find_child(pkgRoot, "reference")
designPkg = find_child(refPkg, "design")
if designPkg is None:
    raise Exception("reference/design not found")

def find_class(pkg, name, depth=0):
    if depth > 60:
        return None
    for c in pkg.getCompositionChildren():
        try:
            if c.getMClass().getName() == "Class" and c.getName() == name:
                return c
        except:
            pass
        found = find_class(c, name, depth + 1)
        if found:
            return found
    return None

def description_note_type(element):
    for noteType in mmExt.findNoteTypes("", element.getMClass()):
        if noteType.getName().lower() == "description":
            return noteType
    return None

def description_content(element):
    nt = description_note_type(element)
    if nt is None:
        return None
    note = element.getNote(nt)
    return note.getContent() if note else None

def set_description(element, content):
    nt = description_note_type(element)
    if nt is None:
        raise Exception("No description NoteType for " + element.getMClass().getName())
    element.putNoteContent(nt, content)

def design_owner_name(spec_owner_name):
    return "KerMLModelElement" if spec_owner_name == "Element" else spec_owner_name

class_cache = {}

def get_class(name):
    if name not in class_cache:
        class_cache[name] = find_class(designPkg, name)
    return class_cache[name]

to_apply = []
not_found_class = []
not_found_end = []
already_has_content = []

for fix in fixes:
    spec_owner_name = fix["owner"]
    owner_name = design_owner_name(spec_owner_name)
    end_name = fix["end"]
    comment = fix["comment"]
    owner_class = get_class(owner_name)
    if owner_class is None:
        not_found_class.append((owner_name, end_name))
        continue
    end = None
    for e in owner_class.getOwnedEnd():
        if e.getName() == end_name:
            end = e
            break
    if end is None:
        not_found_end.append((owner_name, end_name))
        continue
    existing = description_content(end)
    if existing and existing.strip():
        already_has_content.append((owner_name, end_name, existing))
        continue
    to_apply.append((end, owner_name, end_name, comment))

print "resolved to real live design elements, ready to apply:", len(to_apply)
print "owner class not found:", len(not_found_class)
for o, e in not_found_class:
    print "  class not found:", o, "/", e
print "end not found on owner:", len(not_found_end)
for o, e in not_found_end:
    print "  end not found:", o + "." + e
print "already has content (skipped, not overwritten):", len(already_has_content)
for o, e, c in already_has_content:
    print "  already documented:", o + "." + e, ":", repr(c[:60])

changed = 0
tr = modelingSession.createTransaction("Phase 20: propagate ownedEnd descriptions to reference/design")
try:
    for end, owner_name, end_name, comment in to_apply:
        set_description(end, comment)
        changed += 1
    tr.commit()
    print "COMMITTED OK, notes added:", changed
except Exception, e:
    tr.rollback()
    print "ROLLED BACK:", e
    raise

if changed > 0:
    projectService.saveProject(NullProgressMonitor())
    print "isDirty after save:", projectService.isDirty()
else:
    print "NO-OP: project save skipped"
